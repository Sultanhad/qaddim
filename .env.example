# Copy to .env.local and fill in. Only the publishable key belongs in the browser.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Only needed by scripts that send mail themselves (alerts, digests). Supabase sends its own
# sign-in mail through the SMTP settings in its dashboard, not through this key.
RESEND_API_KEY=re_...
RESEND_FROM=قدّم <qaddim@yourdomain>

# Answering by estimate (scripts/answer-questions.mjs) — only for people who switched it on.
# Free: a Gemini key from aistudio.google.com (no billing needed).
GEMINI_API_KEY=
# Paid, and used instead of Gemini when set:
# console.anthropic.com → API keys. Without it that step does nothing and says so.
ANTHROPIC_API_KEY=sk-ant-...
# Optional: the model that writes the answers. Defaults to claude-opus-5-5.
# QADDIM_AI_MODEL=claude-opus-5-5
