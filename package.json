{
  "name": "qaddim-platform",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "sync:engine": "node scripts/sync-engine.mjs",
    "test": "node scripts/sync-engine.mjs --check && node packages/engine/tests/score.test.js && node packages/engine/tests/sources.test.js",
    "dev": "npm --prefix apps/web run dev",
    "build": "npm --prefix apps/web run build",
    "deploy": "npm run build && node scripts/deploy-netlify.mjs",
    "deploy:pages": "sh scripts/deploy-pages.sh",
    "test:rls": "node supabase/tests/rls.test.mjs",
    "test:auth": "node apps/web/tests/auth.test.mjs",
    "test:flow": "node apps/web/tests/flow.test.mjs",
    "test:ext": "node apps/web/tests/extension.test.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.109.0",
    "ws": "^8.22.1"
  }
}
