{
  "name": "qaddim-platform",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "sync:engine": "node scripts/sync-engine.mjs",
    "test": "node scripts/sync-engine.mjs --check && sh scripts/check-migrations.sh && node packages/engine/tests/score.test.js && node packages/engine/tests/sources.test.js",
    "dev": "npm --prefix apps/web run dev",
    "build": "npm --prefix apps/web run build",
    "deploy": "npm run build && node scripts/deploy-netlify.mjs",
    "deploy:pages": "sh scripts/deploy-pages.sh",
    "test:rls": "node supabase/tests/rls.test.mjs",
    "test:auth": "node apps/web/tests/auth.test.mjs",
    "test:flow": "node apps/web/tests/flow.test.mjs",
    "test:ext": "node apps/web/tests/extension.test.mjs",
    "test:fill": "node extension/tests/fill.test.mjs",
    "test:questions": "node apps/web/tests/questions.test.mjs",
    "measure:forms": "node scripts/measure-forms.mjs",
    "test:auto": "node supabase/tests/auto.test.mjs",
    "clean:tests": "node scripts/clean-test-users.mjs",
    "test:all": "npm test && npm run test:rls && npm run test:auto && npm run clean:tests",
    "test:sql": "sh scripts/check-migrations.sh",
    "clean:cvs": "node scripts/clean-orphan-cvs.mjs",
    "test:states": "node apps/web/tests/states.test.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.109.0",
    "ws": "^8.22.1"
  }
}
