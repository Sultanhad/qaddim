{
  "manifest_version": 3,
  "name": "قدّم — تعبئة وإرسال طلبات التوظيف",
  "version": "1.2.0",
  "description": "يعبّي استمارات التوظيف من ملفك ويرسلها، داخل متصفحك أنت.",
  "default_locale": "ar",
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "notifications",
    "alarms"
  ],
  "host_permissions": [
    "https://apply.workable.com/*",
    "https://jobs.lever.co/*",
    "https://jobs.ashbyhq.com/*",
    "https://*.greenhouse.io/*",
    "https://jobs.smartrecruiters.com/*",
    "https://*.recruitee.com/*",
    "https://*.supabase.co/*",
    "https://qaddim.netlify.app/*",
    "https://sultanhad.github.io/*",
    "http://localhost:4173/*",
    "http://localhost:5190/*",
    "https://jobs.unifonic.com/*",
    "https://careers.smartrecruiters.com/*",
    "https://job-boards.greenhouse.io/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "قدّم",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://apply.workable.com/*",
        "https://jobs.lever.co/*",
        "https://jobs.ashbyhq.com/*",
        "https://*.greenhouse.io/*",
        "https://jobs.smartrecruiters.com/*",
        "https://*.recruitee.com/*",
        "https://jobs.unifonic.com/*",
        "https://careers.smartrecruiters.com/*",
        "https://job-boards.greenhouse.io/*"
      ],
      "js": [
        "src/fields.js",
        "src/fill.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "https://qaddim.netlify.app/*",
        "https://sultanhad.github.io/*",
        "http://localhost:4173/*",
        "http://localhost:5190/*"
      ],
      "js": [
        "src/bridge.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
